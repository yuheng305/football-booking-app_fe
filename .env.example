# Example environment variables for the app
# Copy this file to `.env` (or set variables in your CI/build) and update values as needed.

# Base API URL used by the app. Expo only exposes variables prefixed with EXPO_PUBLIC_ to the client bundle.
EXPO_PUBLIC_API_BASE_URL=http://13.214.178.239:8030/api/v1

# Optional app.config/app.json extra fallback names, if you wire them into expo.extra.
EXPO_API_BASE_URL=http://13.214.178.239:8030/api/v1
API_BASE_URL=http://13.214.178.239:8030/api/v1

# Other env examples (if needed):
# SENTRY_DSN=your_sentry_dsn
# GOOGLE_MAPS_API_KEY=your_key
