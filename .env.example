# Example environment variables for the app
# Copy this file to `.env` (or set variables in your CI/build) and update values as needed.

# Base API URL used by the app. Preferred variable is EXPO_API_BASE_URL for Expo builds.
# Fallback: API_BASE_URL
EXPO_API_BASE_URL=https://datn-be-9zkr.onrender.com/api/v1
# Optional alternative name
API_BASE_URL=https://datn-be-9zkr.onrender.com/api/v1

